--- /dev/null
+++ b/backend/test/integration/createTicket.integration.spec.ts
@@ -0,0 +1,224 @@
+/**
+ * D9 — `ticketService.createTicket` integration tests.
+ *
+ * Pins the three behaviors the HD-008 spec's I/O & Edge-Case
+ * Matrix promises for the ticket-creation write path:
+ *
+ *   1. **Happy path** — a single `createTicket` call returns a
+ *      Ticket whose `number` is `HD-21` (counter starts at
+ *      20), whose eager `submitter` include is the test user,
+ *      and whose row exists in `tickets` post-call with
+ *      `status === 'Open'`.
+ *
+ *   2. **Sequential counter increments** — three sequential
+ *      `createTicket` calls return `HD-21`, `HD-22`, `HD-23`
+ *      with no skipped numbers; `Counter.value` reads `23`
+ *      after the third.
+ *
+ *   3. **DUPLICATE_NUMBER race** (the locked HD-008 row) —
+ *      parallel `createTicket` calls all resolve and all
+ *      `number`s are distinct. Verified at two contention
+ *      levels:
+ *      - **2× parallel** (start at 20) → `HD-21`, `HD-22`
+ *        both succeed.
+ *      - **10× parallel stress** (start at 9999) → all 10
+ *        resolve with 10 distinct numbers, `Counter.value`
+ *        is `10009`. Confirms the `lock: UPDATE` on the
+ *        counter row actually serializes the increment +
+ *        insert pair under higher contention.
+ *
+ * Why real MySQL and not sqlite / sequelize-mock: the
+ * DUPLICATE_NUMBER assertion is about MySQL/InnoDB semantics
+ * (`SELECT ... FOR UPDATE` + the UNIQUE index on
+ * `tickets.number`). SQLite parses `FOR UPDATE` as a no-op;
+ * sequelize-mock doesn't exercise the code path. Documented
+ * at length in `_bmad-output/implementation-artifacts/
+ * spec-d9-create-ticket-integration.md`.
+ *
+ * Why we call `createTicket` directly (no supertest, no
+ * Express): the assertion target is the service function
+ * (tx + counter + insert). Booting Express would gate the
+ * spec on unrelated middleware and inflate the time budget.
+ */
+
+import { createTicket } from '../../src/services/ticketService';
+import type { CreateTicketInput } from '../../src/utils/validation/ticketValidation';
+import {
+  sequelize,
+  User,
+  Ticket,
+  Counter,
+  resetTestDb,
+} from './setup';
+
+const validInput: CreateTicketInput = {
+  title: 'My laptop is on fire',
+  description: 'The keyboard is literally melting.',
+  category: 'IT',
+  priority: 'High',
+  attachmentId: null,
+};
+
+async function makeSubmitter(): Promise<{ id: number; email: string }> {
+  const user = await User.create({
+    email: `user-${Date.now()}-${Math.random().toString(36).slice(2, 8)}@example.com`,
+    passwordHash: 'bcrypt-not-relevant-to-this-test',
+    displayName: 'Test Submitter',
+    role: 'User',
+    isActive: true,
+  });
+  return { id: user.id, email: user.email };
+}
+
+describe('ticketService.createTicket (integration)', () => {
+  beforeEach(async () => {
+    // Counter starts at 20 in every spec — matches the dev
+    // seeder at `backend/src/seeders/20260915000000-demo-data.js:162`
+    // so the first ticket is `HD-21`.
+    await resetTestDb({ counterStart: 20 });
+  });
+
+  // ── 1. Happy path ───────────────────────────────────────
+  it('returns HD-21 with the submitter eager-loaded and writes a ticket row', async () => {
+    const submitter = await makeSubmitter();
+
+    const ticket = await createTicket(submitter.id, validInput);
+
+    // Returned instance has the expected shape.
+    expect(ticket.number).toBe('HD-21');
+    expect(ticket.submitterId).toBe(submitter.id);
+    expect(ticket.status).toBe('Open');
+    expect(ticket.title).toBe(validInput.title);
+    expect(ticket.priority).toBe('High');
+    expect(ticket.category).toBe('IT');
+    // Eager-loaded include is hydrated. The Ticket model
+    // class only declares scalar attrs; the `submitter`
+    // include is set on the runtime instance at query time
+    // by Sequelize. Cast to access it.
+    const ticketWithSubmitter = ticket as unknown as {
+      submitter?: { id: number };
+    };
+    expect(ticketWithSubmitter.submitter).toBeDefined();
+    expect(ticketWithSubmitter.submitter?.id).toBe(submitter.id);
+
+    // DB row exists with the right persisted state.
+    const row = await Ticket.findByPk(ticket.id);
+    expect(row).not.toBeNull();
+    expect(row?.number).toBe('HD-21');
+    expect(row?.status).toBe('Open');
+    expect(row?.submitterId).toBe(submitter.id);
+
+    // Counter incremented to 21.
+    const counter = await Counter.findByPk('ticket_number');
+    expect(Number(counter?.value)).toBe(21);
+  });
+
+  // ── 2. Sequential counter increments ─────────────────────
+  it('increments the counter correctly across three sequential calls', async () => {
+    const submitter = await makeSubmitter();
+
+    const t1 = await createTicket(submitter.id, validInput);
+    const t2 = await createTicket(submitter.id, validInput);
+    const t3 = await createTicket(submitter.id, validInput);
+
+    expect(t1.number).toBe('HD-21');
+    expect(t2.number).toBe('HD-22');
+    expect(t3.number).toBe('HD-23');
+
+    const counter = await Counter.findByPk('ticket_number');
+    expect(Number(counter?.value)).toBe(23);
+
+    const allRows = await Ticket.findAll({ order: [['id', 'ASC']] });
+    expect(allRows.length).toBe(3);
+    expect(allRows.map((r) => r.number)).toEqual([
+      'HD-21',
+      'HD-22',
+      'HD-23',
+    ]);
+  });
+
+  // ── 3. DUPLICATE_NUMBER race (the locked HD-008 row) ──────
+  describe('DUPLICATE_NUMBER — parallel createTicket calls', () => {
+    it('two parallel calls both succeed and get distinct numbers', async () => {
+      const submitter = await makeSubmitter();
+
+      const [a, b] = await Promise.all([
+        createTicket(submitter.id, validInput),
+        createTicket(submitter.id, validInput),
+      ]);
+
+      // Both must have resolved.
+      expect(a).toBeDefined();
+      expect(b).toBeDefined();
+
+      // The two numbers are distinct.
+      expect(a.number).not.toBe(b.number);
+
+      // And the set of numbers is exactly {HD-21, HD-22}.
+      const numbers = [a.number, b.number].sort();
+      expect(numbers).toEqual(['HD-21', 'HD-22']);
+
+      // Two rows in tickets, both pointing at the submitter.
+      const rows = await Ticket.findAll({ order: [['id', 'ASC']] });
+      expect(rows.length).toBe(2);
+      for (const row of rows) {
+        expect(row.submitterId).toBe(submitter.id);
+      }
+
+      // Counter is at 22.
+      const counter = await Counter.findByPk('ticket_number');
+      expect(Number(counter?.value)).toBe(22);
+    });
+
+    it('10 parallel calls all succeed with 10 distinct numbers (lock stress)', async () => {
+      // Start the counter at 9999 so we can spot any number
+      // collision or skipped number at a glance.
+      await resetTestDb({ counterStart: 9999 });
+      const submitter = await makeSubmitter();
+
+      const tickets = await Promise.all(
+        Array.from({ length: 10 }, () =>
+          createTicket(submitter.id, validInput),
+        ),
+      );
+
+      expect(tickets.length).toBe(10);
+      // All numbers are distinct (Set size === array length).
+      const numbers = tickets.map((t) => t.number);
+      const unique = new Set(numbers);
+      expect(unique.size).toBe(10);
+
+      // The set is exactly the 10 consecutive ticket numbers
+      // starting at 10000.
+      const sorted = [...unique].sort();
+      expect(sorted[0]).toBe('HD-10000');
+      expect(sorted[9]).toBe('HD-10009');
+      expect(sorted).toEqual([
+        'HD-10000',
+        'HD-10001',
+        'HD-10002',
+        'HD-10003',
+        'HD-10004',
+        'HD-10005',
+        'HD-10006',
+        'HD-10007',
+        'HD-10008',
+        'HD-10009',
+      ]);
+
+      // Counter is at the final value.
+      const counter = await Counter.findByPk('ticket_number');
+      expect(Number(counter?.value)).toBe(10009);
+
+      // 10 rows in tickets — UNIQUE index held.
+      const rowCount = await Ticket.count();
+      expect(rowCount).toBe(10);
+    });
+  });
+});
+
+// Suppress an unused-import warning if a future test
+// ever drops the sequelize handle — keep the import as
+// documentation that this suite talks to the live
+// instance.
+void sequelize;
diff --git a/backend/test/integration/setup.ts b/backend/test/integration/setup.ts
new file mode 100644
index 0000000..663d0d2
--- /dev/null
+++ b/backend/test/integration/setup.ts
@@ -0,0 +1,176 @@
+/**
+ * Integration test bootstrap — D9.
+ *
+ * Runs as `setupFilesAfterEnv` for the `integration` Jest
+ * project (see `backend/jest.config.js`). Two responsibilities:
+ *
+ *   1. **Override the DB env vars** BEFORE the Sequelize
+ *      instance from `src/config/database` is constructed, so
+ *      the integration suite points at the `helpdesk_lite_test`
+ *      database on the same MySQL container the dev app uses.
+ *      Static env mutation at module top + an early import of
+ *      `src/models` cause the singleton to come up against the
+ *      test DB once per Jest worker.
+ *
+ *   2. **Expose `resetTestDb({ counterStart })`**, a single
+ *      helper that (a) `sync({ force: true })` to rebuild the
+ *      schema and (b) seed the
+ *      `('ticket_number', counterStart)` counter row the
+ *      `nextTicketNumber` helper reads. Specs call it in
+ *      `beforeEach` so each `it` starts with a known-good DB
+ *      state.
+ *
+ * The integration suite intentionally:
+ *   - uses a sibling DB on the **same** MySQL container
+ *     (docker-compose.yml) so the test path is byte-identical
+ *     to production (InnoDB, FOR UPDATE, UNIQUE index on
+ *     `tickets.number`).
+ *   - does **not** import migrations or seeders — `sync({ force:
+ *     true })` + a manual counter row cover everything
+ *     `createTicket` touches. Migrations continue to be run in
+ *     dev by `npm run db:migrate` only.
+ *   - does **not** boot Express. The D9 spec is unit-style on
+ *     the service layer: call a function, assert on the DB.
+ *
+ * Connectivity: the probe below runs once per worker. If the
+ * MySQL container is not reachable, the test command fails
+ * fast with a clear message ("start MySQL with `docker compose
+ * up -d mysql`") instead of cascading connection errors
+ * through every spec.
+ */
+
+import type { Sequelize } from 'sequelize';
+
+// ── 1. Env override (must come before any src import that
+//      causes `src/config/database` to run) ────────────────────
+process.env.DB_HOST = process.env.DB_HOST ?? 'localhost';
+process.env.DB_PORT = process.env.DB_PORT ?? '3306';
+process.env.DB_NAME = 'helpdesk_lite_test';
+process.env.DB_USER = process.env.DB_USER ?? 'helpdesk';
+process.env.DB_PASSWORD = process.env.DB_PASSWORD ?? 'helpdesk_pwd';
+// NODE_ENV=test silences morgan on the off-chance anything
+// imports the Express app from inside a spec.
+process.env.NODE_ENV = 'test';
+// Prevent the runtime auth flow from blowing up if anything
+// transitively imports the JWT helper.
+process.env.JWT_SECRET = process.env.JWT_SECRET ?? 'test-secret-do-not-use';
+
+// ── 2. Side-effect import so every model registers + the
+//      central `defineAssociations()` runs once per worker ────
+import {
+  sequelize,
+  User,
+  Ticket,
+  Comment,
+  ActivityLog,
+  Attachment,
+  Counter,
+} from '../../src/models';
+
+// ── 3. Connectivity probe — fail fast with a clear message ──
+let dbAvailable = false;
+
+// 30s gives the dev MySQL container warm-up time + the initial
+// `sequelize.sync({ force: true })` + the 10× parallel race a
+// generous budget. Individual `it`s still complete in <1s.
+jest.setTimeout(30000);
+
+beforeAll(async () => {
+  try {
+    await sequelize.authenticate({ logging: false });
+    dbAvailable = true;
+  } catch (err) {
+    const reason = err instanceof Error ? err.message : String(err);
+    // Re-throw with a friendlier message. Jest's reporter
+    // surfaces this verbatim.
+    throw new Error(
+      `Integration test DB is unreachable at ` +
+        `${process.env.DB_HOST ?? 'localhost'}:${process.env.DB_PORT ?? '3306'} ` +
+        `as \`${process.env.DB_NAME}\`. ` +
+        `Start the dev MySQL container with \`docker compose up -d mysql\` ` +
+        `and wait for the healthcheck to pass. ` +
+        `Underlying error: ${reason}`,
+    );
+  }
+});
+
+afterAll(async () => {
+  if (dbAvailable) {
+    await sequelize.close();
+  }
+});
+
+// ── 4. Helpers exported for the specs ────────────────────────
+
+export interface ResetTestDbOptions {
+  /**
+   * Starting value for the `('ticket_number', …)` counter
+   * row. Defaults to 20 to match the dev seeder
+   * (`backend/src/seeders/20260915000000-demo-data.js:162`).
+   */
+  counterStart?: number;
+}
+
+/**
+ * Wipe + rebuild the schema and re-seed the counter row.
+ *
+ * `sync({ force: true })` drops and recreates every table
+ * declared by the registered models. After that, only the
+ * counter row exists — no users, no tickets — so each `it`
+ * starts with deterministic state.
+ *
+ * Use this in `beforeEach` for specs that create rows; use it
+ * in `beforeAll` only if you're sure no test mutates the
+ * counter.
+ */
+export async function resetTestDb(
+  options: ResetTestDbOptions = {},
+): Promise<void> {
+  const counterStart = options.counterStart ?? 20;
+
+  await sequelize.sync({ force: true });
+
+  await Counter.create({
+    name: 'ticket_number',
+    value: counterStart,
+  });
+}
+
+/**
+ * Truncate row state between specs without dropping the
+ * schema. Faster than `sync({ force: true })` — appropriate
+ * when a spec only adds rows and doesn't change the schema
+ * shape.
+ *
+ * Disables FK checks for the duration so the TRUNCATE
+ * doesn't have to walk the FK graph.
+ */
+export async function truncateAllTables(): Promise<void> {
+  // Tables in FK-safe truncation order (children before
+  // parents in spirit; with FK checks off the order doesn't
+  // matter, but the list mirrors the FK graph for clarity).
+  const tables = [
+    'comments',
+    'activity_logs',
+    'attachments',
+    'tickets',
+    'counters',
+    'users',
+  ];
+  // Use the sequelize instance's `.query` so we don't have
+  // to wrangle the `Transaction` type's missing `.query`
+  // member. Each statement opens and closes its own implicit
+  // tx; the SET FOREIGN_KEY_CHECKS is session-level so the
+  // DDL breaks through the FK constraint regardless.
+  await sequelize.query('SET FOREIGN_KEY_CHECKS = 0');
+  try {
+    for (const table of tables) {
+      await sequelize.query(`TRUNCATE TABLE \`${table}\``);
+    }
+  } finally {
+    await sequelize.query('SET FOREIGN_KEY_CHECKS = 1');
+  }
+}
+
+export { sequelize, User, Ticket, Comment, ActivityLog, Attachment, Counter };
+export type { Sequelize };
