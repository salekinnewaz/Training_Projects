++    }
++    .entry {
++      display: flex;
++      align-items: flex-start;
++      gap: 12px;
++      padding: 10px 0;
++    }
++    .entry-body {
++      display: flex;
++      flex-direction: column;
++      gap: 2px;
++      min-width: 0;
++    }
++    .entry-headline {
++      margin: 0;
++      font-size: 14px;
++      line-height: 1.5;
++      color: var(--color-primary);
++    }
++    .actor-name {
++      font-weight: 600;
++      margin-right: 6px;
++    }
++    .entry-description {
++      color: var(--color-label);
++    }
++    .entry-time {
++      font-size: 12px;
++      color: var(--color-muted);
++    }
++  `],
