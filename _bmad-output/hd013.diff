+    const closedRows = closedCard.querySelectorAll('a.admin-card-row');
+    expect(closedRows.length).toBe(0);
+    const closedMutedRows = closedCard.querySelectorAll('.is-muted');
+    expect(closedMutedRows.length).toBeGreaterThan(0);
