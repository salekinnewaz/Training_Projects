+  const store: Record<string, string> = {};
+  let effect: 'move' | 'none' = 'move';
+  return {
+    getData: (k: string) => store[k] ?? '',
+    setData: (k: string, v: string) => {
+      store[k] = v;
+    },
+    clearData: () => {
+      for (const k of Object.keys(store)) delete store[k];
+    },
+    effectAllowed: 'all',
+    setDragImage: () => undefined,
+    get types() {
