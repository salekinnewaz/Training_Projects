+    listAll: jasmine.Spy;
+    updateRole: jasmine.Spy;
+    updateActive: jasmine.Spy;
+  };
+  let authService: {
+      userSnapshot: jasmine.Spy;
+      user$: Observable<UserPublic | null>;
+      refreshUser: jasmine.Spy;
+    };
+
+  beforeEach(async () => {
