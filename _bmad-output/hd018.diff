+          newPassword: 'short1A',
+        }),
+      (err) =>
+        err.status === 400 &&
+        err.errorCode === 'validation_error' &&
+        err.fields?.newPassword ===
+          'New password must be at least 8 characters.',
+    );
+  });
+
+  it('accepts a newPassword at exactly 8 chars (boundary)', () => {
