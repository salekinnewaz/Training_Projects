+    // Sanitize the filename for Content-Disposition: strip
+    // CR / LF / `"` so a malicious filename can't inject
+    // header content.
+    const safeFilename = attachment.filename
+      .replace(/[\r\n"\\]/g, '_')
+      .slice(0, 200);
