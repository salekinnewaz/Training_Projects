# ─────────────────────────────────────────────────────────────────
# HelpDesk Lite — Monorepo .gitignore
# Covers the root, frontend/ (Angular 17), backend/ (Express + TS),
# and the Postgres Docker volume used for local development.
# ─────────────────────────────────────────────────────────────────

# ── OS / IDE noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.example.json
*.swp
*.swo
*~

# ── Secrets / local config ────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Node / npm workspaces ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Build output ──────────────────────────────────────────────────
dist/
build/
out/
frontend/dist/
frontend/.angular/
backend/dist/
backend/coverage/

# ── Test / coverage artifacts ─────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ──────────────────────────────────────────────────────────
logs/
*.log

# ── Runtime / generated ───────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# Allow .gitkeep markers in any folder so empty source folders
# (e.g. atoms/, molecules/, services/, guards/, patterns/, models/)
# remain tracked even before they're populated.
**/.gitkeep

# ── TypeScript build info ─────────────────────────────────────────
*.tsbuildinfo

# ── Docker / Postgres ────────────────────────────────────────────
.docker/
postgres-data/

# ── Puku CLI installer state ──────────────────────────────────────
# Holds installed skills + per-story review scratch (commit-msg,
# diffs, screenshots, smoke logs). Installer-managed; never part
# of the project source.
.puku-cli/
.vercel

# ── Local Neon / Vercel deployment state ─────────────────────────
# Captures the current neonctl project (`.neon/`) and a hand-rolled
# `.vercel-neon.env` with production DB + JWT secrets. Never commit.
.neon
.neon/
.vercel-neon.env

# ── QA / Playwright debug scratch ────────────────────────────────
# `.qa-tmp/` holds throwaway Playwright probe scripts, generated
# fixture PNGs, and probe screenshots. Not part of the product.
# `test-results/` (and the per-project `qa/test-results/`) are
# Playwright's default output dirs.
.qa-tmp/
test-results/
qa/test-results/

# The HTML report Playwright writes on every run — regenerable.
qa/playwright-report/

# The QA screenshots are debug scratch EXCEPT the reference PNG.
# `qa/screenshots/local-view/ref-full.png` is the WDS-2026 mockup
# crop that every number in `qa/scripts/ref-measurements.js` is
# derived from, so it is tracked; everything else in the folder is
# a scratch capture.
qa/screenshots/*
!qa/screenshots/local-view/
qa/screenshots/local-view/*
!qa/screenshots/local-view/ref-full.png
