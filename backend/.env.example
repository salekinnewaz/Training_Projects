# ─────────────────────────────────────────────────────────────────
# HelpDesk Lite backend — Environment variables (template).
# Copy to `.env` so dotenv picks it up at server startup.
# ─────────────────────────────────────────────────────────────────

# Database — Postgres 16 (matches docker-compose.yml credentials).
# In production on Vercel, set POSTGRES_URL (pooled) and
# POSTGRES_URL_DIRECT (non-pooled, for migrations) in the project's
# Environment Variables — they take precedence over the DB_* values
# below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_lite
DB_USER=helpdesk
DB_PASSWORD=helpdesk_pwd

# HTTP server
PORT=3000
NODE_ENV=development

# JWT (lands in HD-003)
JWT_SECRET=change-me-in-prod-please-use-a-real-secret
JWT_EXPIRES_IN=1h

# CORS — origin allowed by the dev frontend
FRONTEND_ORIGIN=http://localhost:4200

# The dev frontend ports allowed to call the API with credentials.
# Comma-separated. Both `localhost` and `127.0.0.1` are accepted for
# each port. Two devs (or two IDEs) often run the frontend at the
# same time, so the second instance moves to another port — add it
# here (or to FRONTEND_ORIGINS) rather than editing server.ts.
FRONTEND_PORTS=4200,4300

# Extra individual origins, comma-separated, if a port is not enough
# (e.g. a tunnel). FRONTEND_ORIGIN above is always allowed.
# FRONTEND_ORIGINS=https://my-tunnel.example.com
