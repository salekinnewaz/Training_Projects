# ─────────────────────────────────────────────────────────────────
# HelpDesk Lite backend — Test environment template (D9).
#
# The integration test suite (test:integration) points at a
# sibling database `helpdesk_lite_test` on the same MySQL
# container the dev app uses. The schema is owned by the test
# suite — `sequelize.sync({ force: true })` wipes + recreates
# every table on `beforeAll`, and the spec's `beforeEach`
# truncates row state.
#
# To redirect at a different host, copy this file to .env.test
# (gitignored) and edit. The setup file's defaults match the
# docker-compose.yml container, so most contributors won't
# need to override anything.
# ─────────────────────────────────────────────────────────────────

# Database — same container as dev, different database name.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk_lite_test
DB_USER=helpdesk
DB_PASSWORD=helpdesk_pwd
