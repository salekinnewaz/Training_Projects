# ─────────────────────────────────────────────────────────────────
# HelpDesk Lite — Environment variables (template).
# Copy to `.env` (root) for local development. The backend also reads
# a copy via dotenv from backend/.env if present; the root .env is
# the canonical reference for IDE / shell use.
# ─────────────────────────────────────────────────────────────────

# ── Database (Postgres 16 — see docker-compose.yml) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_lite
DB_USER=helpdesk
DB_PASSWORD=helpdesk_pwd

# Production on Vercel: set POSTGRES_URL (pooled) and
# POSTGRES_URL_DIRECT (non-pooled, for migrations) in the project's
# Environment Variables — they take precedence over DB_* above.
# POSTGRES_URL=postgres://neondb_owner:...@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL_DIRECT=postgres://neondb_owner:...@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Backend HTTP server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT auth (used by HD-003) ─────────────────────────────────────
JWT_SECRET=change-me-in-prod-please-use-a-real-secret
JWT_EXPIRES_IN=1h

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:4200
