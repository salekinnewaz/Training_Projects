# ─────────────────────────────────────────────────────────────────
# HelpDesk Lite — Environment variables (template).
# Copy to `.env` (root) for local development. The backend also reads
# a copy via dotenv from backend/.env if present; the root .env is
# the canonical reference for IDE / shell use.
# ─────────────────────────────────────────────────────────────────

# ── Database (Postgres 16 — see docker-compose.yml) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_lite
DB_USER=helpdesk
DB_PASSWORD=helpdesk_pwd

# Production on Vercel: set POSTGRES_URL (pooled) and
# POSTGRES_URL_DIRECT (non-pooled, for migrations) in the project's
# Environment Variables — they take precedence over DB_* above.
# POSTGRES_URL=postgres://neondb_owner:...@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL_DIRECT=postgres://neondb_owner:...@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Backend HTTP server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT auth (used by HD-003) ─────────────────────────────────────
JWT_SECRET=change-me-in-prod-please-use-a-real-secret
JWT_EXPIRES_IN=1h

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:4200

# ── Attachment storage (HD-016) ───────────────────────────────────
# Which backend persists uploaded file bytes:
#   fs   — local filesystem under `<cwd>/uploads`. The default, so
#          local dev needs no configuration.
#   blob — a private Vercel Blob store. REQUIRED on Vercel: the
#          serverless filesystem is read-only except /tmp, and /tmp
#          is ephemeral per function instance, so bytes written
#          there do not survive.
# Any other value is a boot error — the app refuses to start rather
# than silently falling back to `fs`.
# ATTACHMENT_STORAGE_BACKEND=fs

# Maximum upload size in bytes. Defaults to 4 MB on Vercel (the
# platform rejects bodies over 4.5 MB before the app sees them) and
# 10 MB elsewhere. Set explicitly to override either default.
# MAX_UPLOAD_BYTES=10485760

# Vercel Blob — the read/write token for the private store. Set
# automatically by Vercel when a Blob store is connected to the
# project; you do not need to create it by hand.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
